{"title":{"text":"How do pricing and fees work?"},"buttonText":"Close","paragraphs":[{"title":"Overview","subtitle":"Delivery Fees and Service Fees are charged on delivery orders and are separate from the item prices shown on the merchant...s menu and at cart.","isTitleBold":true,"style":"PLAIN"},{"title":"Delivery Fee","subtitle":"Varies based on things like your location, the merchant, the availability of nearby delivery people and whether you are an Uber One member.","isTitleBold":true,"style":"PLAIN"},{"title":"Service Fee","subtitle":"Restaurant: varies per order but always between $2.50 and $6.50. Retail incl. grocery, pharmacy and alcohol: up to 15% of your subtotal but always between $2 and $15. Convenience: up to 15% of your subtotal but always between $2 and $4, plus a Small Order Service Fee of $2 if your subtotal is under $15.","isTitleBold":true,"style":"PLAIN"},{"title":"Other Fees","subtitle":"Bag fees or other eco-fees may apply if mandated by law or charged by the merchant.","isTitleBold":true,"style":"PLAIN"},{"title":"Checkout","subtitle":"All fees are also visible at checkout.","isTitleBold":true,"style":"PLAIN"},{"title":"Learn More","subtitle":"https://z.uber.com/fees","isTitleBold":true,"style":"PLAIN"}]}7
