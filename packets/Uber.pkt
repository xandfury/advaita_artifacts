		.marquee-scroll {
			margin: 0 auto;
			will-change: transform;
			display: inline-block;
			animation: marquee 11s linear infinite;
			animation-delay: 3s;
		}

		[data-ref="marquee-container"].is-truncated {
			mask-image: linear-gradient(to left, rgba(0, 0, 0, 0), rgb(0, 0, 0) 18%);
		}

		[dir="rtl"] .marquee-scroll {
			animation-name: marquee-rtl;
		}

		[dir="rtl"] [data-ref="marquee-container"].is-truncated {
			mask-image: linear-gradient(to right, rgba(0, 0, 0, 0), rgb(0, 0, 0) 18%);
		}

		@keyframes marquee {
			0% { transform: translateX(0); }
			73% { transform: translateX(calc(-50%)); }
			100% { transform: translateX(calc(-50%)); }
		}

		@keyframes marquee-rtl {
			0% { transform: translateX(0); }
			73% { transform: translateX(calc(50%)); }
