(http_body/base64/json)
{
  "buttonText": "Close",
  "paragraphs": [
    {
      "isTitleBold": "true",
      "style": "PLAIN",
      "subtitle": "Delivery Fees and Service Fees are charged on delivery orders and are separate from the item prices shown on the merchant\u00e2\u0080\u0099s menu and at cart.",
      "title": "Overview"
    },
    {
      "isTitleBold": "true",
      "style": "PLAIN",
      "subtitle": "Varies based on things like your location, the merchant, the availability of nearby delivery people and whether you are an Uber One member.",
      "title": "Delivery Fee"
    },
    {
      "isTitleBold": "true",
      "style": "PLAIN",
      "subtitle": "Restaurant: varies per order but always between $2.50 and $6.50. Retail incl. grocery, pharmacy and alcohol: up to 15% of your subtotal but always between $2 and $15. Convenience: up to 15% of your subtotal but always between $2 and $4, plus a Small Order Service Fee of $2 if your subtotal is under $15.",
      "title": "Service Fee"
    },
    {
      "isTitleBold": "true",
      "style": "PLAIN",
      "subtitle": "Bag fees or other eco-fees may apply if mandated by law or charged by the merchant.",
      "title": "Other Fees"
    },
    {
      "isTitleBold": "true",
      "style": "PLAIN",
      "subtitle": "All fees are also visible at checkout.",
      "title": "Checkout"
    },
    {
      "isTitleBold": "true",
      "style": "PLAIN",
      "subtitle": "https://z.uber.com/fees",
      "title": "Learn More"
    }
  ],
  "title": {
    "text": "How do pricing and fees work?"
  }
}


