(http_body/base64/json)
{
  "buttonText": "OK",
  "key": "refund_policy_bottom_sheet",
  "paragraphs": [
    {
      "isTitleBold": "true",
      "style": "PLAIN",
      "subtitle": "Only fresh fruits and vegetables, fresh eggs, fresh dairy products, raw meat or seafood purchased from a store listed in the Grocery section of the Uber Eats are eligible for a refund or Uber Cash under this policy. You must report the issue to Uber Support within 48 hours of delivery, including a clear photo showing the problem.",
      "title": "Eligibility"
    },
    {
      "isTitleBold": "true",
      "style": "PLAIN",
      "subtitle": "Exclusions apply. Uber may refuse refunds or Uber Cash for complaints we believe are fraudulent, illegal, or otherwise in violation of Uber\u00e2\u0080\u0099s terms of use. See: https://p.uber.com/terms-of-use",
