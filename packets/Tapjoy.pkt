      .TJ__offer-bg-color__color {
        color: #fdf9ed !important;
      }

      /* offer_button_bg_color */
      .TJ__offer-button-bg-color__background {
        background: #ef3e34 !important;
      }

      /* offer_button_font_color */
      .TJ__offer-button-font-color__color {
        color: #ffffff !important;
      }
      .TJ__offer-button-font-color__border-color {
        border-color: #ffffff !important;
      }
