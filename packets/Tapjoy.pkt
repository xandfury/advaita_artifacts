      }
      .TJ__offer-name-font-color__fill {
        fill: #5f2b0e !important;
      }
      .TJ__offer-name-font-color__stroke {
        stroke: #5f2b0e !important;
      }

      /* offer_detail_font_color */
      .TJ__offer-detail-font-color__fill {
        fill: #a2a2a2 !important;
      }
      .TJ__offer-detail-font-color__stroke {
        stroke: #a2a2a2 !important;
      }

      /* offer_border_color */
      .TJ__offer-border-color__background {
        background: #d0ccc2 !important;
      }
      .TJ__offer-border-color__border-color {
        border-color: #d0ccc2 !important;
      }
      .TJ__offer-border-color__border-bottom-color {
        border-bottom-color: #d0ccc2 !important;
      }

      /* currency_icon_url */
      .TJ__currency-icon-url__background-image {
        background-image: url(https://content.offerwall.unity3d.com/assets-5rocks-server/uploaded/custom_offerwall_images/files/original/6718c9f59339e314b7000328f741c53bc490d2699d01e16318c69156.png) !important;
      }

      /* bg_color */
      .TJ__bg-color__backgroud {
        background: #ede4ca !important;
      }

      /* header_bg_color */
      .TJ__header-bg-color__background {
        background: #3d110b !important;
      }

      /* header_font_color */
      .TJ__header-font-color__color {
        color: #ffffff !important;
      }
      .TJ__header-font-color__background,
      .TJ__header-font-color__background__before:before,
      .TJ__header-font-color__background__after:after {
        background: #ffffff !important;
      }
      .TJ__header-font-color__border-color {
        border-color: #ffffff !important;
      }

      /* offer-detail-font-color */
      .TJ__offer-detail-font-color__color {
        color: #a2a2a2 !important;
      }

      /* offer_button_sub_bg_color */
      .TJ__offer-button-sub-bg-color__background {
        background: #de1e13 !important;
      }
      .TJ__offer-button-sub-bg-color__border-bottom-color {
        border-bottom-color: #de1e13 !important;
      }
      .TJ__offer-button-sub-bg-color__border-left-color {
        border-left-color: #de1e13 !important;
      }

      /* offer_button_sub_font_color */
      .TJ__offer-button-sub-font-color__color {
        color: #ffa5a0 !important;
