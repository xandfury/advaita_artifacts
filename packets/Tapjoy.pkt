      /* body background */
      body {
        background-color: #ede4ca !important;
      }

      /* image preload */
      body::after {
        position: absolute;
        width: 0;
        height: 0;
        overflow: hidden;
        z-index: -1;
      }

      body.reduced-m2e {
        background-color: rgba(0, 0, 0, 0.6) !important; 
      }
      body.reduced-m2e .pre-render-container {
        width: 75%;
        height: 75%;
        margin: auto;
      }

      body.reduced-m2e .pre-render-container .pre-render-message  {
        background-repeat: no-repeat;
        background-position: center;
        background-size: contain;
      }

      body.reduced-m2e .pre-render-container .pre-render-header  {
        display: none;
      }

      /* pre-render */
      .pre-render-container {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        display: flex;
        -ms-flex-direction: column;
        -webkit-flex-direction: column;
        flex-direction: column;
      }

      .pre-render-message {
        width: 104%;
        height: 104%;
        margin-top: -2%;
        margin-left: -2%;
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover;
        z-index: 1000;
        position: absolute;
        opacity: 1;
      }

      .pre-render-header {
        flex: 0 0 auto;
        width: 100%;
      }

      .pre-render-header-cover {
        opacity: 1;
      }

      .pre-render-header-text {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        font-size: 17px;
        color: #ffffff;
        text-align: center;
        padding: 0px 40px;
        background: #3d110b;
      }

      .pre-render-header-img {
        display: none;
        top: 0;
        left: 0;
        width: 100%;
        position: relative;
      }

      .pre-render-body {
        flex: 1 1 auto;
        width: 100%;
        position: relative;
      }

      .pre-render-error-section {
        opacity: 0;
        margin: 0 auto;
        display: none;
        font-size: 14px;
        color: #5f2b0e;
        width: 80%;
        padding: 20px 10px;
      }

      .pre-render-error-box {
        padding: 8px;
        text-align: center;
      }

      .pre-render-error-icon {
        position: relative;
        margin: 0 auto 16px auto;
        width: 64px;
        height: 64px;
        padding: 8px;
        display: flex;
        -ms-flex-direction: column;
        -webkit-flex-direction: column;
        justify-content: center;
        align-items: center;
      }

      .pre-render-error-icon-fill {
        fill: #5f2b0e;
      }

      .pre-render-error-icon::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background-color: #5f2b0e;
        opacity: 0.1;
      }

      .pre-render-error-title {
        font-size: 17px;
        font-weight: 600;
        margin-bottom: 15px;
      }

      .pre-render-error-detail {
        line-height: 1.3;
        font-weight: normal;
      }

      .pre-render-error-contact {
        text-align: center;
        color: #5f2b0e;
        margin-top: 20px;
        line-height: 1.5;
      }

      .pre-render-error-contact a {
        color: #5f2b0e;
        text-decoration: underline;
      }

      /* error case*/

      body.is-error {
        background-color: #fdf9ed !important;
      }

      body.is-error .pre-render-header-cover {
        opacity: 0;
        height: 32px;
        transition: opacity 0.3s ease-in-out;
      }

      body.is-error .pre-render-message {
        transition: opacity 0.5s ease-in-out;
        opacity: 0;
      }

      body.is-error .pre-render-error-section {
        opacity: 1;
        display: block;
        transition: opacity 0.3s ease-in-out;
      }

      body.is-error .pre-render-throbber {
        display: none;
      }

      @media all and (orientation: portrait) {
        .pre-render-message {
          background-image:url();
        }
        .pre-render-header {
          min-height: 56px;
        }
        .pre-render-header-text {
          height: 56px;
          line-height: 56px;
        }
        .pre-render-header-img.portrait {
          display: block;
          min-height: 66px;
        }

        .pre-render-body {
          display: flex;
          align-items: center;
          justify-content: center;
        }
      }

      @media all and (orientation: landscape) {
        .pre-render-message {
          background-image:url();
        }
        .pre-render-header {
          min-height: 32px;
        }
        .pre-render-header-text {
          height: 32px;
          line-height: 32px;
        }
        .pre-render-header-img.landscape {
          display: block;
          min-height: 42px;
        }

        .pre-render-body {
          overflow-y: auto;
        }

        body.is-error .pre-render-header {
          height: 32px;
        }
      }

      .is-tjc .pre-render-header,
      .is-tjc .pre-render-header-text,
      .is-tjc .pre-render-header-cover{
        height: 64px;
      }
      
      .is-tjc .pre-render-header-text {
        line-height: 64px;
      }

      .is-tjc .pre-render-header,
      .is-tjc .pre-render-header-cover {
        min-height: 64px;
      }

      /* pre-render end */</style><style>/* bg_color */
